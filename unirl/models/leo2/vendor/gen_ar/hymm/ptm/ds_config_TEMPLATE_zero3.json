{
    "train_batch_size" : CONFIG_BATCH_SIZE,
    "train_micro_batch_size_per_gpu": CONFIG_MBSIZE,
    "steps_per_print": LOG_INTERVAL,
  
    "optimizer": {
      "type": "AdamW",
      "params": {
        "lr": 1e-4,
        "betas": [
          0.9,
          0.999
        ],
        "eps": 1e-8,
        "weight_decay": 0.0
      }
    },
  
    "zero_optimization": {
      "stage": 3,
      "allgather_partitions": true,
      "overlap_comm": true,
      "reduce_scatter": false,
      "contiguous_gradients": true,
      "stage3_prefetch_bucket_size": 1e8,
      "stage3_max_live_parameters" : 1e8,
      "reduce_bucket_size": 6e8,
      "load_repartition_dense": true,
      "sub_group_size": 1e9,
      "sub_group_buffer_num": 10,
      "pipeline_optimizer": true,
      "max_contigous_event_size": 0,
      "cache_sub_group_rate": 0.0,
      "prefetch_cache_sub_group_rate": 0.0,
      "max_contigous_params_size": -1,
      "max_param_reduce_events": 0,
      "stage3_param_persistence_threshold": 9e9,
      "is_communication_time_profiling": false,
      "save_large_model_multi_slice": true,
      "offload_optimizer": {
        "device": "cpu",
        "pin_memory": true
      },
      "offload_param": {
        "device": "cpu",
        "pin_memory": true
      }
    },
    
    "gradient_clipping": 0.01,
    "prescale_gradients": true,

    "fp16": {
      "enabled": CONFIG_FP16_ENABLED,
      "loss_scale": 0,
      "loss_scale_window": 500,
      "hysteresis": 2,
      "min_loss_scale": 1,
      "initial_scale_power": 15
    },

    "bf16": {
      "enabled": CONFIG_BF16_ENABLED
    },

    "wall_clock_breakdown" : false,
    "mem_chunk": {
        "default_chunk_size": 134217727,
        "use_fake_dist": false,
        "client": {
            "mem_tracer": {
                "use_async_mem_monitor": true,
                "warmup_gpu_chunk_mem_ratio": 0.8,
                "overall_gpu_mem_ratio": 0.8,
                "overall_cpu_mem_ratio": 1.0,
                "margin_use_ratio": 0.8,
                "use_fake_dist": false
            },
            "opts": {
                "with_mem_cache": true,
                "with_async_move": true
            }
        }
    }
}
